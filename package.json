{
  "name": "pi-error-auto",
  "version": "0.2.1",
  "description": "Force native retries and invisibly continue interrupted Pi turns.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "extension",
    "retry",
    "error-recovery",
    "auto-continue",
    "invisible"
  ],
  "license": "MIT",
  "homepage": "https://github.com/KorenKrita/pi-error-auto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KorenKrita/pi-error-auto.git"
  },
  "bugs": {
    "url": "https://github.com/KorenKrita/pi-error-auto/issues"
  },
  "files": [
    "index.ts",
    "auto-continue.ts",
    "forced-retry.ts",
    "invisible-continue.ts",
    "config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test *.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
